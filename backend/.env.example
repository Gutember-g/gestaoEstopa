# Variáveis de ambiente para o Backend Spring Boot (Produção / Render / Neon)

# Perfil ativo do Spring Boot (dev | prod)
SPRING_PROFILES_ACTIVE=prod

# Porta informada pelo Render (injetada automaticamente pelo Render)
PORT=8080

# URL de Conexão JDBC com o PostgreSQL do Neon (Use a versão Pooled URL do Neon com sslmode=require)
DATABASE_URL=jdbc:postgresql://ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Credenciais de acesso ao banco PostgreSQL Neon
DB_USER=seu_usuario_neon
DB_PASS=sua_senha_neon

# Configurações do Pool de Conexões HikariCP
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# Segredo JWT (Chave forte aleatória de no mínimo 256 bits / 32 caracteres)
JWT_SECRET_PROD=sua_chave_secreta_super_segura_jwt_para_producao_1234567890

# Origens permitidas pelo CORS (separadas por vírgula se houver mais de uma)
ALLOWED_ORIGINS=https://sua-aplicacao.vercel.app

# Configuração do Cookie SameSite (Strict em dev local, None para Vercel + Render cross-site)
COOKIE_SAME_SITE=None
